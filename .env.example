# Datenquelle: mock oder webull
SCANNER_MODE=mock

# Webull OpenAPI (niemals echte Secrets committen)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_TOKEN_DIR=.webull_tokens

# Scanner
UNIVERSE_SIZE=25
TOP_N=3
BAR_COUNT=120
SCAN_INTERVAL_SECONDS=300
USE_ORDER_BOOK=true
REQUEST_DELAY_SECONDS=1.05
MIN_PRICE=0.20
MAX_PRICE=50.00
MIN_DOLLAR_VOLUME_5M=25000

# Speicherung
DATABASE_PATH=data/scanner.db
LATEST_CSV_PATH=output/latest_candidates.csv
MODEL_PATH=models/momentum_model.joblib

# Automatischer prospektiver Lernzyklus
LEARNING_ENABLED=true
LEARNING_HORIZON_HOURS=24
LEARNING_THRESHOLDS=0.10,0.20,0.50,1.00
LEARNING_PRIMARY_THRESHOLD=0.20
LEARNING_TRACK_TOP_N=50
LEARNING_EVENT_GAP_MINUTES=120
LEARNING_FINALIZE_PER_SCAN=30
LEARNING_REFRESH_SYMBOLS_PER_SCAN=30
LEARNING_MIN_BARS_PER_EVENT=8
LEARNING_RETRAIN_HOURS=24
LEARNING_MIN_ROWS=200
LEARNING_MIN_POSITIVES=20
LEARNING_MIN_NEW_LABELS=40
LEARNING_MIN_AP_IMPROVEMENT=0.005
LEARNING_MAX_BRIER_DEGRADATION=0.02
LEARNING_MIN_LIFT_OVER_BASE=1.10
